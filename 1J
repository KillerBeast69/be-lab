# 1_dna_analysis.py
"""
How to perform: 
1. Install biopython: `pip install biopython`
2. Run script: `python 1_dna_analysis.py`

Viva Topics:
- GC Content: The percentage of Guanine and Cytosine bases; higher GC means higher stability/melting point due to 3 hydrogen bonds.
- Motif: A short, recurring sequence pattern suspected to have a biological function.
- Coding Region: Portions of DNA that get translated into proteins (exons).
"""
from Bio.Seq import Seq
from Bio.SeqUtils import gc_fraction

seq = Seq("ATGCGTACGTAGCTAGCTAGCTGATCGATCGTAGCTAGCTAGCTAGCTA")

# 1. GC Content
print(f"GC Content: {gc_fraction(seq):.2f}")
# 2. Find Motif
print(f"Motif 'GCTA' count: {seq.count('GCTA')}")
# 3. Coding Region (Translation)
print(f"Translation: {seq.translate()}")

# 2_rna_seq_analysis.py
"""
How to perform:
1. Install dependencies: `pip install pandas scipy`
2. Run script: `python 2_rna_seq_analysis.py`

Viva Topics:
- RNA-Seq: Uses next-gen sequencing to reveal presence and quantity of RNA (transcriptome).
- Differential Expression: Finding genes whose expression significantly differs between conditions (Control vs Treatment).
- P-value: Probability that the observed difference occurred by chance; < 0.05 is typically significant.
"""
import pandas as pd
from scipy.stats import ttest_ind

# Mock Data: 2 genes across 3 Control and 3 Treatment samples
data = {'Gene': ['GeneA', 'GeneB'], 
        'C1':[10, 2], 'C2':[12, 3], 'C3':[11, 2], 
        'T1':[50, 2], 'T2':[55, 3], 'T3':[52, 4]}
df = pd.DataFrame(data).set_index('Gene')

# Perform basic t-test for differential expression
p_values = df.apply(lambda r: ttest_ind(r[['C1','C2','C3']], r[['T1','T2','T3']]).pvalue, axis=1)

print("Differentially Expressed Genes (p < 0.05):\n", p_values[p_values < 0.05])

# 4_ml_genomic_data.py
"""
How to perform:
1. Install scikit-learn: `pip install scikit-learn numpy`
2. Run script: `python 4_ml_genomic_data.py`

Viva Topics:
- Random Forest: An ensemble learning method using multiple decision trees to improve accuracy and prevent overfitting.
- Feature Importance: Identifying which genomic markers most strongly predict the class (e.g., disease vs. healthy).
- Classification: Supervised learning mapping input data to discrete labels.
"""
import numpy as np
from sklearn.ensemble import RandomForestClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

# Dummy Data: 100 samples, 10 genomic markers, binary labels
X, y = np.random.rand(100, 10), np.random.randint(0, 2, 100)
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)

# Train & Predict
clf = RandomForestClassifier(n_estimators=10).fit(X_train, y_train)
preds = clf.predict(X_test)

print(f"Accuracy: {accuracy_score(y_test, preds):.2f}")
print("Feature Importances:", clf.feature_importances_)

# 5_text_preprocessing.py
"""
How to perform:
1. Install nltk: `pip install nltk`
2. Run script: `python 5_text_preprocessing.py` (Downloads 'stopwords' automatically).

Viva Topics:
- Stop Words: Common words (a, an, the, is) stripped before processing to save space and improve search relevance.
- Stemming: Heuristic process chopping off word ends to reduce words to their root (e.g., 'running' to 'run').
- Lemmatization (Alternative): Uses vocabulary/morphology to return the proper base dictionary word.
"""
import nltk
from nltk.corpus import stopwords
from nltk.stem import PorterStemmer

nltk.download('stopwords', quiet=True)
text = "The runners are running quickly."

# Pre-process
words = text.lower().split()
stops = set(stopwords.words('english'))
stemmer = PorterStemmer()

processed = [stemmer.stem(w) for w in words if w not in stops]
print("Processed Text:", processed)

# 6_inverted_files.py
"""
How to perform:
1. Native Python, no installation needed.
2. Run script: `python 6_inverted_files.py`

Viva Topics:
- Inverted Index: A dictionary-like data structure mapping terms/words to the documents that contain them.
- Purpose: Core mechanism for search engines allowing ultra-fast full-text searches.
- Retrieval: Using sets allows quick intersection for multi-word queries (e.g., 'machine' AND 'learning').
"""
documents = {
    1: "machine learning tutorial", 
    2: "deep learning concepts", 
    3: "machine searching techniques"
}

inverted_index = {}

# Build Index
for doc_id, text in documents.items():
    for word in text.split():
        inverted_index.setdefault(word, set()).add(doc_id)
        
print("Inverted Index:", inverted_index)
print("Query 'learning': Docs", inverted_index.get('learning', set()))

# 7_email_spam_filtering.py
"""
How to perform:
1. Install scikit-learn: `pip install scikit-learn`
2. Run script: `python 7_email_spam_filtering.py`

Viva Topics:
- Naive Bayes: Probabilistic classifier based on Bayes' theorem assuming independence between features (words).
- CountVectorizer: Converts text documents to a matrix of token counts (Bag of Words model).
- Text Classification: Assigning predefined categories (Spam/Ham) to free-text documents.
"""
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.naive_bayes import MultinomialNB

emails = ["Win free money now!", "Meeting scheduled at 10am", "Claim your free prize"]
labels = [1, 0, 1] # 1=Spam, 0=Ham

# Vectorize & Train
vec = CountVectorizer()
X = vec.fit_transform(emails)
clf = MultinomialNB().fit(X, labels)

# Test new email
test = vec.transform(["Meeting prize money"])
print("Prediction (1=Spam, 0=Ham):", clf.predict(test)[0])

# 8_hierarchical_clustering.py
"""
How to perform:
1. Install dependencies: `pip install scikit-learn numpy`
2. Run script: `python 8_hierarchical_clustering.py`

Viva Topics:
- Agglomerative Clustering: A "bottom-up" approach where each point starts in its own cluster, and pairs are iteratively merged.
- Linkage Criteria: Determines the distance between sets of observations (e.g., Ward, Complete, Single, Average).
- Unsupervised Learning: No pre-labeled data is provided; the algorithm finds inherent groupings.
"""
from sklearn.cluster import AgglomerativeClustering
import numpy as np

# Sample 2D dataset
X = np.array([[1, 2], [1, 4], [1, 0], [10, 2], [10, 4], [10, 0]])

# Cluster into 2 groups
clustering = AgglomerativeClustering(n_clusters=2).fit(X)

print("Data Points:\n", X)
print("Cluster Assignments:", clustering.labels_)

# 9_web_crawler.py
"""
How to perform:
1. Install requests and beautifulsoup4: `pip install requests beautifulsoup4`
2. Run script: `python 9_web_crawler.py`

Viva Topics:
- Web Crawler: Automated script that browses the internet systematically to index or extract data.
- BeautifulSoup: A Python library for parsing HTML/XML documents, extracting data using DOM tags.
- Politeness/Ethics: Always checking `robots.txt` and limiting request rates to avoid crashing the target server.
"""
import requests
from bs4 import BeautifulSoup

# Using a public sandbox site built explicitly for scraping practice
url = "http://books.toscrape.com/" 
response = requests.get(url)
soup = BeautifulSoup(response.text, 'html.parser')

# Extract product title and price
products = soup.select('.product_pod')[:3] # Limit to 3 for brevity

for p in products:
    title = p.h3.a['title']
    price = p.select_one('.price_color').text
    print(f"Product: {title} | {price}")

